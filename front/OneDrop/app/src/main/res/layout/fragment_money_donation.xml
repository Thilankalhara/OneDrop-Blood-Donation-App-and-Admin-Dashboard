<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <!-- ── Crimson Header ── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#DC143C"
                android:paddingTop="24dp"
                android:paddingBottom="32dp">

                <View
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:background="@drawable/circle_red_light"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="-55dp"
                    android:layout_marginTop="-30dp" />
                <View
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="@drawable/circle_red_light"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="-25dp"
                    android:layout_marginBottom="-25dp" />

                <!-- Back + Title -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/moneyBackBtn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="←"
                        android:textSize="20sp"
                        android:textColor="#FFFFFF"
                        android:gravity="center"
                        android:background="@drawable/circle_red_light" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Money Donation"
                        android:textSize="18sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center" />

                    <View android:layout_width="40dp" android:layout_height="40dp" />

                </LinearLayout>

                <!-- Amount display -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="56dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SELECTED AMOUNT"
                        android:textSize="10sp"
                        android:textColor="#FFCCCC"
                        android:fontFamily="@font/poppins_semibold"
                        android:letterSpacing="0.12" />

                    <TextView
                        android:id="@+id/selectedAmountTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$5"
                        android:textSize="52sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/selectedAmountDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Funds blood drive supplies for 1 donor"
                        android:textSize="13sp"
                        android:textColor="#FFCCCC"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </FrameLayout>

            <!-- ── White body ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="20dp">

                <!-- Pick amount label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PICK AN AMOUNT"
                    android:textSize="10sp"
                    android:textColor="#AAAAAA"
                    android:fontFamily="@font/poppins_semibold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="12dp" />

                <!-- Preset cards -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <LinearLayout android:id="@+id/preset1" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginEnd="6dp" android:orientation="vertical"
                        android:gravity="center" android:padding="10dp"
                        android:background="@drawable/card_white_border">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="USD" android:textSize="9sp" android:textColor="#AAAAAA"
                            android:fontFamily="@font/poppins_regular" />
                        <TextView android:id="@+id/presetAmount1" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="$1" android:textSize="20sp"
                            android:textColor="#1A1A1A" android:fontFamily="@font/poppins_bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="TEST KIT\nFOR 1\nDONOR" android:textSize="8sp"
                            android:textColor="#AAAAAA" android:fontFamily="@font/poppins_regular"
                            android:gravity="center" android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/preset2" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
                        android:orientation="vertical" android:gravity="center" android:padding="10dp"
                        android:background="@drawable/btn_red_rounded">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="USD" android:textSize="9sp" android:textColor="#FFCCCC"
                            android:fontFamily="@font/poppins_regular" />
                        <TextView android:id="@+id/presetAmount2" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="$5" android:textSize="20sp"
                            android:textColor="#FFFFFF" android:fontFamily="@font/poppins_bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="DRIVE\nSUPPLY\nPACK" android:textSize="8sp"
                            android:textColor="#FFCCCC" android:fontFamily="@font/poppins_regular"
                            android:gravity="center" android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/preset3" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
                        android:orientation="vertical" android:gravity="center" android:padding="10dp"
                        android:background="@drawable/card_white_border">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="USD" android:textSize="9sp" android:textColor="#AAAAAA"
                            android:fontFamily="@font/poppins_regular" />
                        <TextView android:id="@+id/presetAmount3" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="$10" android:textSize="20sp"
                            android:textColor="#1A1A1A" android:fontFamily="@font/poppins_bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="FULL DONOR\nCARE" android:textSize="8sp"
                            android:textColor="#AAAAAA" android:fontFamily="@font/poppins_regular"
                            android:gravity="center" android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/preset4" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="6dp" android:orientation="vertical"
                        android:gravity="center" android:padding="10dp"
                        android:background="@drawable/card_white_border">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="USD" android:textSize="9sp" android:textColor="#AAAAAA"
                            android:fontFamily="@font/poppins_regular" />
                        <TextView android:id="@+id/presetAmount4" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="$50" android:textSize="20sp"
                            android:textColor="#1A1A1A" android:fontFamily="@font/poppins_bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="SPONSOR A\nDRIVE" android:textSize="8sp"
                            android:textColor="#AAAAAA" android:fontFamily="@font/poppins_regular"
                            android:gravity="center" android:layout_marginTop="2dp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Custom amount -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Custom Amount"
                    android:textSize="13sp"
                    android:textColor="#1A1A1A"
                    android:fontFamily="@font/poppins_semibold"
                    android:layout_marginBottom="8dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="24dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/input_border_gray"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$"
                            android:textSize="18sp"
                            android:textColor="#DC143C"
                            android:fontFamily="@font/poppins_bold"
                            android:layout_marginEnd="6dp" />
                        <EditText
                            android:id="@+id/customAmountEt"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:hint="Enter amount..."
                            android:textColorHint="#CCCCCC"
                            android:textSize="15sp"
                            android:textColor="#1A1A1A"
                            android:fontFamily="@font/poppins_regular"
                            android:inputType="numberDecimal"
                            android:background="@null"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/clearCustomBtn"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="✕"
                        android:textSize="12sp"
                        android:textColor="#AAAAAA"
                        android:gravity="center"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="10dp"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- ══════════════════════════════════════════ -->
                <!-- ── Card Details section ── -->
                <!-- ══════════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Card Details"
                    android:textSize="13sp"
                    android:textColor="#1A1A1A"
                    android:fontFamily="@font/poppins_semibold"
                    android:layout_marginBottom="10dp" />

                <!-- Card number field -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/input_border_gray"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <!-- Card brand badge — updates dynamically -->
                        <TextView
                            android:id="@+id/cardBrandTv"
                            android:layout_width="40dp"
                            android:layout_height="26dp"
                            android:text="💳"
                            android:textSize="11sp"
                            android:textColor="#CCCCCC"
                            android:gravity="center"
                            android:fontFamily="@font/poppins_bold"
                            android:layout_marginEnd="10dp" />

                        <EditText
                            android:id="@+id/cardNumberEt"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:hint="Card number"
                            android:textColorHint="#CCCCCC"
                            android:textSize="15sp"
                            android:textColor="#1A1A1A"
                            android:fontFamily="@font/poppins_regular"
                            android:inputType="number"
                            android:maxLength="19"
                            android:background="@null"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:letterSpacing="0.08" />

                    </LinearLayout>
                </FrameLayout>

                <!-- Expiry + CVC row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <!-- Expiry MM/YY -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/input_border_gray"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📅"
                            android:textSize="14sp"
                            android:layout_marginEnd="8dp" />

                        <EditText
                            android:id="@+id/cardExpiryEt"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:hint="MM/YY"
                            android:textColorHint="#CCCCCC"
                            android:textSize="15sp"
                            android:textColor="#1A1A1A"
                            android:fontFamily="@font/poppins_regular"
                            android:inputType="number"
                            android:maxLength="5"
                            android:background="@null"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp" />

                    </LinearLayout>

                    <!-- CVC -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/input_border_gray"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒"
                            android:textSize="14sp"
                            android:layout_marginEnd="8dp" />

                        <EditText
                            android:id="@+id/cardCvcEt"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:hint="CVC"
                            android:textColorHint="#CCCCCC"
                            android:textSize="15sp"
                            android:textColor="#1A1A1A"
                            android:fontFamily="@font/poppins_regular"
                            android:inputType="numberPassword"
                            android:maxLength="4"
                            android:background="@null"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Summary -->
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#F0F0F0" android:layout_marginBottom="16dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Donation amount"
                        android:textSize="13sp" android:textColor="#555555"
                        android:fontFamily="@font/poppins_regular" />
                    <TextView android:id="@+id/summaryAmountTv" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="$5.00"
                        android:textSize="13sp" android:textColor="#1A1A1A"
                        android:fontFamily="@font/poppins_semibold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Processing fee"
                        android:textSize="13sp" android:textColor="#555555"
                        android:fontFamily="@font/poppins_regular" />
                    <TextView android:id="@+id/summaryFeeTv" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="$0.00"
                        android:textSize="13sp" android:textColor="#1A1A1A"
                        android:fontFamily="@font/poppins_semibold" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#F0F0F0" android:layout_marginBottom="12dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="24dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Total"
                        android:textSize="14sp" android:textColor="#1A1A1A"
                        android:fontFamily="@font/poppins_bold" />
                    <TextView android:id="@+id/summaryTotalTv" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="$5.00"
                        android:textSize="14sp" android:textColor="#DC143C"
                        android:fontFamily="@font/poppins_bold" />
                </LinearLayout>

                <!-- Donate button -->
                <LinearLayout
                    android:id="@+id/donateBtn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/btn_red_rounded">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="❤️  " android:textSize="16sp" />
                    <TextView
                        android:id="@+id/donateBtnText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Donate $5"
                        android:textSize="15sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/poppins_bold" />
                </LinearLayout>

                <!-- Secure badge -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center"
                    android:layout_marginTop="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🔒 " android:textSize="11sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Secured by Stripe. Your card is never stored."
                        android:textSize="11sp" android:textColor="#AAAAAA"
                        android:fontFamily="@font/poppins_regular" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</FrameLayout>