<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F5">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="100dp">

                <!-- ══════════════════════════════════════════ -->
                <!-- ── Crimson Header ── -->
                <!-- ══════════════════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#DC143C"
                    android:paddingTop="24dp"
                    android:paddingBottom="32dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- Decorative circles -->
                        <View
                            android:layout_width="160dp"
                            android:layout_height="160dp"
                            android:background="@drawable/circle_red_light"
                            android:layout_gravity="top|end"
                            android:layout_marginEnd="-55dp"
                            android:layout_marginTop="-30dp" />
                        <View
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:background="@drawable/circle_red_light"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="-25dp"
                            android:layout_marginBottom="-25dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <!-- Title -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Donate"
                                android:textSize="22sp"
                                android:textColor="#FFFFFF"
                                android:fontFamily="@font/poppins_bold"
                                android:gravity="center"
                                android:layout_marginBottom="6dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Every act of giving saves lives.\nChoose how you'd like to contribute today."
                                android:textSize="13sp"
                                android:textColor="#FFCCCC"
                                android:fontFamily="@font/poppins_regular"
                                android:gravity="center"
                                android:layout_marginBottom="24dp" />

                            <!-- Stats row -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:background="@drawable/badge_red_dark"
                                android:paddingTop="12dp"
                                android:paddingBottom="12dp"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp">

                                <!-- Blood Donations -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center">
                                    <TextView
                                        android:id="@+id/statBloodDonations"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="—"
                                        android:textSize="22sp"
                                        android:textColor="#FFFFFF"
                                        android:fontFamily="@font/poppins_bold" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="MY DONATIONS"
                                        android:textSize="9sp"
                                        android:textColor="#FFAAAA"
                                        android:fontFamily="@font/poppins_semibold"
                                        android:letterSpacing="0.08" />
                                </LinearLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="36dp"
                                    android:background="#FF6666"
                                    android:layout_gravity="center_vertical" />

                                <!-- Lives Helped -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center">
                                    <TextView
                                        android:id="@+id/statLivesHelped"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="—"
                                        android:textSize="22sp"
                                        android:textColor="#FFFFFF"
                                        android:fontFamily="@font/poppins_bold" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="LIVES HELPED"
                                        android:textSize="9sp"
                                        android:textColor="#FFAAAA"
                                        android:fontFamily="@font/poppins_semibold"
                                        android:letterSpacing="0.08" />
                                </LinearLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="36dp"
                                    android:background="#FF6666"
                                    android:layout_gravity="center_vertical" />

                                <!-- Total Contributed -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center">
                                    <TextView
                                        android:id="@+id/statContributed"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="—"
                                        android:textSize="22sp"
                                        android:textColor="#FFFFFF"
                                        android:fontFamily="@font/poppins_bold" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="CONTRIBUTED"
                                        android:textSize="9sp"
                                        android:textColor="#FFAAAA"
                                        android:fontFamily="@font/poppins_semibold"
                                        android:letterSpacing="0.08" />
                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </FrameLayout>

                </LinearLayout>

                <!-- ══════════════════════════════════════════ -->
                <!-- ── Choose Donation Type ── -->
                <!-- ══════════════════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CHOOSE DONATION TYPE"
                        android:textSize="10sp"
                        android:textColor="#AAAAAA"
                        android:fontFamily="@font/poppins_semibold"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="14dp"
                        android:layout_marginTop="8dp" />

                    <!-- ✅ Horizontal row of donation type cards -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Blood Donation Card -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/bloodDonationCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#DC143C">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <!-- Icon bg -->
                                <FrameLayout
                                    android:layout_width="52dp"
                                    android:layout_height="52dp"
                                    android:layout_marginBottom="12dp">
                                    <TextView
                                        android:layout_width="52dp"
                                        android:layout_height="52dp"
                                        android:text="🩸"
                                        android:textSize="26sp"
                                        android:gravity="center"
                                        android:background="@drawable/badge_red_dark" />
                                </FrameLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Blood\nDonation"
                                    android:textSize="16sp"
                                    android:textColor="#FFFFFF"
                                    android:fontFamily="@font/poppins_bold"
                                    android:layout_marginBottom="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Schedule or verify a blood donation at a nearby center"
                                    android:textSize="11sp"
                                    android:textColor="#FFCCCC"
                                    android:fontFamily="@font/poppins_regular"
                                    android:layout_marginBottom="16dp" />

                                <TextView
                                    android:id="@+id/donateBloodBtn"
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:text="Donate Blood →"
                                    android:textSize="12sp"
                                    android:textColor="#DC143C"
                                    android:fontFamily="@font/poppins_semibold"
                                    android:gravity="center"
                                    android:background="@drawable/avatar_white" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                        <!-- Money Donation Card -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/moneyDonationCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FFFFFF">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <!-- Icon bg -->
                                <FrameLayout
                                    android:layout_width="52dp"
                                    android:layout_height="52dp"
                                    android:layout_marginBottom="12dp">
                                    <TextView
                                        android:layout_width="52dp"
                                        android:layout_height="52dp"
                                        android:text="💰"
                                        android:textSize="26sp"
                                        android:gravity="center"
                                        android:background="@drawable/badge_pink_light" />
                                </FrameLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Money\nDonation"
                                    android:textSize="16sp"
                                    android:textColor="#1A1A1A"
                                    android:fontFamily="@font/poppins_bold"
                                    android:layout_marginBottom="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Fund blood drives, supplies &amp; donor support programs"
                                    android:textSize="11sp"
                                    android:textColor="#888888"
                                    android:fontFamily="@font/poppins_regular"
                                    android:layout_marginBottom="16dp" />

                                <TextView
                                    android:id="@+id/donateMoneyBtn"
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:text="Donate Money →"
                                    android:textSize="12sp"
                                    android:textColor="#FFFFFF"
                                    android:fontFamily="@font/poppins_semibold"
                                    android:gravity="center"
                                    android:background="@drawable/btn_red_rounded" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <!-- ══════════════════════════════════════════ -->
                    <!-- ── Money Donation History ── -->
                    <!-- ══════════════════════════════════════════ -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MONETARY DONATION HISTORY"
                        android:textSize="10sp"
                        android:textColor="#AAAAAA"
                        android:fontFamily="@font/poppins_semibold"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="12dp"
                        android:layout_marginTop="24dp" />

                    <!-- Loading state -->
                    <TextView
                        android:id="@+id/moneyHistoryLoading"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="Loading..."
                        android:textSize="13sp"
                        android:textColor="#CCCCCC"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"
                        android:visibility="visible" />

                    <!-- Empty state -->
                    <LinearLayout
                        android:id="@+id/moneyHistoryEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💰"
                            android:textSize="36sp"
                            android:gravity="center"
                            android:layout_marginBottom="8dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No monetary donations yet"
                            android:textSize="13sp"
                            android:textColor="#CCCCCC"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- History list container -->
                    <LinearLayout
                        android:id="@+id/moneyHistoryContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</FrameLayout>