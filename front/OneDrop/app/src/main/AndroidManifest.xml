<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet Access Permission -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notification Permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required for Vibrator.vibrate() -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Required camera permission -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Location permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Storage permission (if you really need it) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OneDrop"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Splash Screen Activity (Main Launcher) -->
        <!-- ✅ singleTop prevents multiple instances -->
        <activity
            android:name=".Activity.Fragment.SplashActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.OneDrop.FullScreen"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding Activity -->
        <activity
            android:name=".Activity.OnboardingActivity"
            android:exported="false"
            android:launchMode="standard"
            android:theme="@style/Theme.OneDrop.FullScreen"
            android:screenOrientation="portrait" />

        <!-- Main Activity -->
        <activity
            android:name=".Activity.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:alwaysRetainTaskState="false"
            android:theme="@style/Theme.OneDrop.FullScreen"
            android:screenOrientation="portrait" />

        <!-- Sign In Activity -->
        <activity
            android:name=".Activity.SignInActivity"
            android:exported="true"
            android:launchMode="standard"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait" />

        <!-- Sign Up Activity -->
        <activity
            android:name=".Activity.SignUpActivity"
            android:exported="true"
            android:launchMode="standard"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:screenOrientation="portrait" />

        <!-- Forgot Password Activity -->
        <activity
            android:name=".Activity.ForgetPasswordActivity"
            android:exported="true"
            android:launchMode="standard"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:screenOrientation="portrait" />

        <!-- Enter Code Activity (OTP Verification for Password Reset) -->
        <activity
            android:name=".Activity.EnterCodeActivity"
            android:exported="true"
            android:launchMode="standard"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:screenOrientation="portrait" />

        <!-- Verify Email Activity -->
        <activity
            android:name=".Activity.VerifyEmailActivity"
            android:exported="true"
            android:launchMode="standard"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:screenOrientation="portrait" />

        <!-- Reset Password Activity -->
        <activity
            android:name=".Activity.ResetPasswordActivity"
            android:exported="true"
            android:launchMode="standard"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait" />

        <!-- Firebase Messaging Service -->
        <service
            android:name=".Activity.services.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>